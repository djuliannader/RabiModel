Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"x_", ",", "p_", ",", "g_", ",", "\[Lambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "^", "2"}], "+", 
       RowBox[{"x", "^", "2"}]}], ")"}], "/", "2"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}]}], "*", "g", "*", "x"}], "+", 
           "\[Lambda]"}], ")"}], "^", "2"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}]}]}], ";"}]], "Input",
