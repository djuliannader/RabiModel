Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Second", " ", "derivative", " ", "of", " ", "the", " ", "ground", " ", 
    "states", " ", "energy", " ", "as", " ", "a", " ", "function", " ", "of", 
    " ", "g"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"D2GSQRM", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"D2GSAQRM1", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"D2GSAQRM2", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"D2GSAQRM3", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"der", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DGSQRM", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"DGSQRM", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], "/", "ep"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"der1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DGSAQRM1", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"DGSAQRM1", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], "/", "ep"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"der2", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DGSAQRM2", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"DGSAQRM2", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], "/", "ep"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"der3", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DGSAQRM3", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"DGSAQRM3", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], "/", "ep"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"D2GSQRM", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GSQRM", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "der"}], "}"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"D2GSAQRM1", ",", 
