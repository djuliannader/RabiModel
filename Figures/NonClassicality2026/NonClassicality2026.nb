Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Color", " ", "for", " ", "the", " ", "Wigner", " ", "function"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FCo", "[", "t_", "]"}], "=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{"1", ",", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"2", "t"}], ")"}], "3"], ",", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"2", "t"}], ")"}], "3"]}], "]"}], ",", 
         RowBox[{"0", "<=", "t", "<=", 
          RowBox[{"1", "/", "2"}]}]}], "}"}], ",", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{"RGBColor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"t", "-", 
                FractionBox["1", "2"]}], ")"}]}]}], ")"}], ",", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"2", 
              RowBox[{"(", 
               RowBox[{"t", "-", 
                FractionBox["1", "2"]}], ")"}]}]}], ")"}], ",", "1"}], "]"}], 
         ",", 
         RowBox[{
          RowBox[{"1", "/", "2"}], "<", "t", "<=", "1"}]}], "}"}]}], "}"}], 
     "]"}]}], ";"}]}]], "Input",
