Notebook[{
Cell["\<\
Here we analyse detectable squeezing from characteristic functions, checked \
on Fock states\
\>", "Text",
 CellChangeTimes->{{4.0029587422662077`*^9, 
  4.002958785025606*^9}},ExpressionUUID->"81c19b83-e684-4fbb-9e89-\
1cbf2f22bbb6"],

Cell[TextData[{
 "Detectable squeezing is evaluated as the relative curvature at the global \
maximum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb524045-c21e-43f0-aca7-ac67ff3eaadc"],
 " of a probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebc07c6a-6c2d-459e-822e-fa857603e475"]
}], "Text",
 CellChangeTimes->{{4.0029587888912563`*^9, 
  4.002958823203216*^9}},ExpressionUUID->"34507e66-4e92-4a84-841a-\
6a6f13d57c48"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"\[ScriptCapitalV]", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"p", "(", "x", ")"}], 
     RowBox[{"|", 
      RowBox[{
       RowBox[{"p", "''"}], 
       RowBox[{"(", "x", ")"}]}], "|"}]], 
    SubscriptBox["|", 
     RowBox[{"x", " ", "=", " ", "a"}]]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"0fdbafa9-873f-434b-9753-e6b0a5734f7f"]], \
"Text",
 CellChangeTimes->{{4.002958828251856*^9, 4.0029588606219*^9}, {
  4.002958947739489*^9, 
  4.0029590616782007`*^9}},ExpressionUUID->"ac476fbc-1829-412c-b591-\
5a80c9519385"],

Cell["We have the following relation", "Text",
 CellChangeTimes->{{4.002959079636516*^9, 
  4.00295909323958*^9}},ExpressionUUID->"6650721e-f45f-48fb-8c44-\
e1040936d14e"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"p", "(", "x", ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[Pi]"}]], 
    RowBox[{"\[Integral]", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
      RowBox[{"\[Phi]", "(", "t", ")"}], "dt"}]}]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"94bf5f20-e2d4-4535-b7b1-9eeb0bdc18ce"]], \
"Text",
 CellChangeTimes->{{4.0029590991102037`*^9, 
  4.002959126686249*^9}},ExpressionUUID->"4890750c-6519-404e-b18b-\
7e698d6a97d6"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "943dfa09-0152-4942-a513-c2c02bdd7031"],
 " is the characteristic function for the density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "017da972-aeab-4231-9e16-d91ce131faab"]
}], "Text",
 CellChangeTimes->{{4.00295913075167*^9, 
  4.00295914711871*^9}},ExpressionUUID->"cf7d11ee-a8b4-4ead-adb6-\
a04039ac601c"],

Cell["Therefore", "Text",
 CellChangeTimes->{{4.002959151441976*^9, 
  4.002959152178887*^9}},ExpressionUUID->"182fba8c-b1b2-4d9b-801d-\
0e4c590c8ca6"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"\[ScriptCapitalV]", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[Integral]", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
        RowBox[{"\[Phi]", "(", "t", ")"}], " ", "dt"}]}], 
      RowBox[{"|", 
       RowBox[{
        SubscriptBox["\[PartialD]", "x"], 
        RowBox[{"\[Integral]", " ", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
          RowBox[{"\[Phi]", "(", "t", ")"}], "dt"}]}]}], "|"}]], 
     SubscriptBox["|", 
      RowBox[{"x", "=", "a"}]]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[Integral]", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
         RowBox[{"\[Phi]", "(", "t", ")"}], " ", "dt"}]}], 
       RowBox[{"|", 
        RowBox[{"\[Integral]", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "i"}], " ", "t"}], ")"}], "2"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
          RowBox[{"\[Phi]", "(", "t", ")"}], "dt"}]}], "|"}]], 
      SubscriptBox["|", 
       RowBox[{"x", "=", "a"}]]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Integral]", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
         RowBox[{"\[Phi]", "(", "t", ")"}], " ", "dt"}]}], 
       RowBox[{"|", 
        RowBox[{"\[Integral]", 
         RowBox[{
          SuperscriptBox["t", "2"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "i"}], " ", "t", " ", "x"}]], 
          RowBox[{"\[Phi]", "(", "t", ")"}], "dt"}]}], "|"}]], 
      SubscriptBox["|", 
       RowBox[{"x", "=", "a"}]]}]}]}]}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"28e86fa2-cc9a-42e2-9749-72c372360993"]], \
"Text",
 CellChangeTimes->{{4.002959158410303*^9, 
  4.0029593009319887`*^9}},ExpressionUUID->"d3ff0ce3-afa5-42ce-8ffe-\
6079bdb336fc"],

Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{4.002958768671912*^9, 
  4.0029587695782146`*^9}},ExpressionUUID->"0dfd9f0e-47e3-4e20-b8d8-\
2027c741a833"],

Cell["The Fock state quadrature probability densities are ", "Text",
 CellChangeTimes->{{4.00295877146413*^9, 4.002958773926893*^9}, {
  4.002959306838832*^9, 
  4.002959315082247*^9}},ExpressionUUID->"f9d66840-3b46-4921-835f-\
4b872154d8cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PFock", "[", 
   RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}]], 
    SqrtBox["\[Pi]"]], 
   FractionBox[
    SuperscriptBox[
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", "x"}], "]"}], "2"], 
    RowBox[{
     SuperscriptBox["2", "n"], 
     RowBox[{"n", "!"}]}]]}]}]], "Input",
 CellChangeTimes->{{4.0029598246639214`*^9, 4.002959826212144*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"c9305e60-e694-4292-a352-da051efc43d4"],

Cell["\<\
The Fock state quadrature characteristic functions are simply the quantum \
characteristic functions with one variable evaluated at 0. They are symmetric \
under exchange of variables and under reflection\
\>", "Text",
 CellChangeTimes->{{4.002959386807082*^9, 
  4.0029594517055473`*^9}},ExpressionUUID->"7c1dc5de-8b64-42bd-bd76-\
912ddbbc69b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Chi]0", "[", 
   RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Mu]", "2"], "+", 
      SuperscriptBox["\[Nu]", "2"]}], ")"}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]n", "[", 
   RowBox[{"n_", ",", "\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Chi]0", "[", 
    RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
   RowBox[{"LaguerreL", "[", 
    RowBox[{"n", ",", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Mu]", "2"], "+", 
        SuperscriptBox["\[Nu]", "2"]}], ")"}]}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]", "[", 
   RowBox[{"n_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"\[Chi]n", "[", 
   RowBox[{"n", ",", "0", ",", "t"}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.002959462221901*^9, 4.0029594755481043`*^9}, {
  4.002959524916057*^9, 4.002959548826631*^9}, {4.002960554385014*^9, 
  4.0029605550191927`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"fbf18ae1-c467-492a-9308-82334ea9c529"],

Cell["The detectable squeezing is calculated numerically", "Text",
 CellChangeTimes->{{4.002959624633503*^9, 
  4.0029596413976088`*^9}},ExpressionUUID->"74b3cfbd-0b48-4576-854d-\
b1504ece12cf"],

Cell["Find global maximum", "Text",
 CellChangeTimes->{{3.9862680526180573`*^9, 
  3.986268059295068*^9}},ExpressionUUID->"014fa15d-c3dc-4051-af30-\
95717cf1a8c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"xmaxD", "[", "prob_", "]"}], ":=", 
  RowBox[{
   RowBox[{"xmaxD", "[", "prob", "]"}], "=", 
   RowBox[{"Last", "@", 
    RowBox[{"MaximalBy", "[", 
     RowBox[{
      RowBox[{"x", "/.", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"prob", ",", "x"}], "]"}], "==", "0"}], ",", "x", ",", 
         "Reals"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Evaluate", "@", "prob"}], "/.", 
        RowBox[{"x", "->", "#"}]}], "&"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.0029597496283703`*^9, 4.002959800596493*^9}, {
  4.0029598394476833`*^9, 4.002959841713437*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"07e1da55-5ef4-4b0c-82b9-8cd69c512916"],

Cell["Asymptotic squeezing from probability densities", "Text",
 CellChangeTimes->{{3.950849246313558*^9, 3.950849252856873*^9}, {
  4.0029601735078707`*^9, 
  4.002960177267427*^9}},ExpressionUUID->"6cb6009b-3cf7-4e36-811b-\
25e6cba46a8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"As", "[", "prob_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"ReplaceAll", "[", 
      RowBox[{"x", "->", 
       RowBox[{"xmaxD", "[", "prob", "]"}]}], "]"}], "[", "prob", "]"}], 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"ReplaceAll", "[", 
       RowBox[{"x", "->", 
        RowBox[{"xmaxD", "[", "prob", "]"}]}], "]"}], "[", 
      RowBox[{"D", "[", 
       RowBox[{"prob", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}]]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.950849354672867*^9, 3.950849361220804*^9}, {
  3.9508494176597443`*^9, 3.9508494565303802`*^9}, {3.950852737612253*^9, 
  3.9508527475751953`*^9}, {3.950860492001967*^9, 3.950860497787507*^9}, {
  3.950864075632155*^9, 3.950864077748674*^9}, {3.986316944388756*^9, 
  3.986316944768216*^9}, {4.002959894791336*^9, 4.002959932205481*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"b6f1cb35-c1c8-49db-85c0-83d2f9623433"],

Cell["\<\
Asymptotic squeezing from characteristic functions (for Fock states)\
\>", "Text",
 CellChangeTimes->{{4.002960181677042*^9, 4.002960191357685*^9}, {
  4.002960306970908*^9, 
  4.002960310062845*^9}},ExpressionUUID->"9ec47c18-f3cd-44e9-aa3f-\
be459e5fbd8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AsCF", "[", 
   RowBox[{"prob_", ",", "cf_"}], "]"}], ":=", 
  RowBox[{"Chop", "@", 
   FractionBox[
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "t", " ", 
         RowBox[{"xmaxD", "[", "prob", "]"}]}]], "cf"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}], "]"}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["t", "2"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "t", " ", 
         RowBox[{"xmaxD", "[", "prob", "]"}]}]], "cf"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}], 
     "]"}]]}]}]], "Input",
 CellChangeTimes->{{4.0029601979953203`*^9, 4.002960249809807*^9}, {
  4.0029602856194763`*^9, 4.002960376608094*^9}, {4.002960688702601*^9, 
  4.002960690221981*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"7acd429d-a2e9-4950-a070-bb6ae0961109"]
}, Open  ]],

Cell[CellGroupData[{

