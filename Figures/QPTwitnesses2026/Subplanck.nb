Cell[BoxData[{
 RowBox[{
  RowBox[{"dx", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioFromData", "[", "mar_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "f", ",", "idx", ",", "x0", ",", "solMax", ",", "a", ",", "fa", ",", 
       "f2a", ",", "ratio"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"mar", ",", 
         RowBox[{"Method", "->", "\"\<Spline\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idx", "=", 
       RowBox[{
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"mar", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x0", "=", 
       RowBox[{"mar", "[", 
        RowBox[{"[", 
         RowBox[{"idx", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solMax", "=", 
       RowBox[{"FindMaximum", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], ",", 
           RowBox[{
            RowBox[{"x0", "-", "dx"}], "<=", "x", "<=", 
            RowBox[{"x0", "+", "dx"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "x0"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"x", "/.", " ", 
        RowBox[{"solMax", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fa", "=", 
       RowBox[{"f", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"f2a", "=", 
       RowBox[{
        RowBox[{"f", "''"}], "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratio", "=", 
       RowBox[{"fa", "/", 
        RowBox[{"Abs", "[", "f2a", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "->", "a"}], ",", 
        RowBox[{"\"\<f(a)\>\"", "->", "fa"}], ",", 
        RowBox[{"\"\<f''(a)\>\"", "->", "f2a"}], ",", 
        RowBox[{"\"\<ratio\>\"", "->", "ratio"}], ",", 
        RowBox[{"\"\<f\>\"", "->", "f"}]}], "|>"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.984551569598404*^9, 3.9845515698775473`*^9}, {
  3.984551687327281*^9, 3.984551687919238*^9}, {3.9845520736477118`*^9, 
  3.984552077643003*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"3c215f20-d558-407d-bee0-e73594dcaa08"],

