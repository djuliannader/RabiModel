   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tau", "=", "0.038"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"==", 
      RowBox[{
      "3.", " ", "Extract", " ", "x", " ", "and", " ", "p", " ", "grid", " ", 
       "values"}]}], "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xVals", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pVals", "=", 
