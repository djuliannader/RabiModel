       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"pVals", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
