        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nx", "=", 
     RowBox[{"Length", "[", "xVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"np", "=", 
     RowBox[{"Length", "[", "pVals", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Grid", " ", "spacings"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", 
     RowBox[{
      RowBox[{"xVals", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"xVals", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dp", "=", 
     RowBox[{
