          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{"2", " ", "t"}]}], ")"}], "^", "6"}], ",", "1"}], "]"}], 
        ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], "<", "t", "<=", "1"}]}], "}"}]}], "}"}], 
    "]"}]}]}]], "Input",
