          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", " ", "t"}], ")"}], "^", "6"}]}], "]"}], ",", 
        RowBox[{"0", "<=", "t", "<=", 
         RowBox[{"1", "/", "2"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "-", 
