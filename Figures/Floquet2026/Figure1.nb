Cell[BoxData[{
 RowBox[{
  RowBox[{"Chi", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"L", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NN", "="}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xinst", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"WignerTWA", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xmax", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"WignerTWA", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pinst", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"WignerTWA", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pmax", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"WignerTWA", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"xinst", "<", "xmax"}], ",", 
    RowBox[{
     RowBox[{"word", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"datawigner", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "xinst"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"val", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"L", "/", "NN"}]}], ")"}], "*", 
         RowBox[{"word", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "word", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"Marx", ",", 
       RowBox[{"{", 
        RowBox[{"xinst", ",", "val"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xinst", "=", 
      RowBox[{"xinst", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "L"}], ")"}], "/", "NN"}]}]}]}]}], "]"}], 
  ";"}], "\n"}], "Input",
