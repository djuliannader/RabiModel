   "Initial", " ", "Wigner", " ", "function", " ", "for", " ", "TWA"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"q0", "=", "0.0"}], ";", 
    RowBox[{"p0", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", "50"}], ";"}], " ", 
